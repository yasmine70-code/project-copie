# Configuration du serveur ESP32 CAM
ESP32_PORT=3001

# URL du backend principal
MAIN_BACKEND_URL=http://localhost:3000

# Configuration des uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=./uploads/esp32-cam

# Configuration WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=60000

# Configuration des dispositifs
MAX_CONNECTED_DEVICES=50
DEVICE_INACTIVE_TIMEOUT=60000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/esp32-server.log

# Sécurité
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Base de données (si nécessaire)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=esp32_surveillance
# DB_USER=esp32_user
# DB_PASSWORD=your_password

# Notifications
# WEBHOOK_URL=https://your-webhook-url.com/notify
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
